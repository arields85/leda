# Este archivo SÍ se versiona y nunca contiene valores reales.
# Copiar a .env y completar con valores reales; .env no se versiona.

# Base de datos
PRISMA_DB_URL=postgresql://prisma:cambiame@localhost:5432/prisma

# Conexión separada del gateway para confirmar acciones sensibles.
# El login mínimo debe ser miembro sólo de prisma_gateway.
PRISMA_AUTHORITY_DB_URL=

# Proveedor de LLM. Qué modelo usar se configura en la tabla model_config,
# desde la consola de administración. Acá va sólo la credencial.
PRISMA_LLM_API_KEY=

# Tokens de los bots de Telegram, uno por espacio de trabajo. La clave es el
# slug del espacio, en mayúsculas.
#
# ESTE ARCHIVO ENTRA A GIT. Los valores reales van en .env, que está ignorado.
PRISMA_BOT_TOKEN_COREWORK=

# Un bot por cada espacio que agregues. Este es sólo un ejemplo del nombre que
# tendría que llevar el día que exista ese equipo; hoy no hace falta.
# PRISMA_BOT_TOKEN_MANTENIMIENTO=

# El bot de administración: no pertenece a ningún equipo. Es el único canal
# donde se puede configurar Prisma, cambiar el modelo, ver incidentes y leer
# conversaciones. Escribiendo por el bot de CoreWork, un administrador es un
# integrante más. Para el piloto podés dejarlo vacío.
PRISMA_BOT_TOKEN_ADMIN=

# Secreto que Telegram devuelve en cada webhook, para verificar el origen.
PRISMA_WEBHOOK_SECRET=

# URL pública donde Telegram entrega los webhooks
PRISMA_BASE_URL=https://prisma.example.com

# OpenRouter: la usa Jev y, si model_config elige el proveedor openrouter, también el modelo conversacional.
PRISMA_OPENROUTER_API_KEY=
